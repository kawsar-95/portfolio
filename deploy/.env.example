# Copy this file to `.env` on the server (NEVER commit real values).
# The deploy pipeline reads IMAGE at `docker compose pull` time; anything else is
# injected into the `web` container at runtime.

# --- Set by the GitHub Actions deploy job (do not edit manually) ---
IMAGE=ghcr.io/chishty313/devops-themed-personal-portfolio:latest

